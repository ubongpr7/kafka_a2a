{
  "schema_version": 1,
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile",
    "args": {
      "KA2A_UV_EXTRAS": "server,auth,lang,redis,mcp,voice"
    }
  },
  "migration": {
    "target": "ka2a-gateway",
    "container_name": "ka2a-gateway",
    "command": []
  },
  "targets": {
    "ka2a-gateway": {
      "family": "interaims-dev-ka2a-gateway",
      "taskRoleArn": "arn:aws:iam::220979325244:role/interaims-dev-ecs-task",
      "executionRoleArn": "arn:aws:iam::220979325244:role/interaims-dev-ecs-execution",
      "networkMode": "awsvpc",
      "containerDefinitions": [
        {
          "name": "ka2a-gateway",
          "image": "__IMAGE_URI__",
          "cpu": 0,
          "portMappings": [
            {
              "containerPort": 7006,
              "hostPort": 7006,
              "protocol": "tcp"
            }
          ],
          "essential": true,
          "command": [
            "gateway",
            "--default-agent",
            "host",
            "--host",
            "0.0.0.0",
            "--port",
            "7006"
          ],
          "environment": [
            {
              "name": "KA2A_CONTROL_PLANE_BASE_URL",
              "value": "http://127.0.0.1:7006"
            }
          ],
          "mountPoints": [],
          "volumesFrom": [],
          "systemControls": []
        },
        {
          "name": "ka2a-runtime",
          "image": "__IMAGE_URI__",
          "cpu": 0,
          "portMappings": [],
          "essential": true,
          "command": [
            "runtime"
          ],
          "environment": [
            {
              "name": "KA2A_CONTROL_PLANE_BASE_URL",
              "value": "http://127.0.0.1:7006"
            }
          ],
          "mountPoints": [],
          "volumesFrom": [],
          "systemControls": []
        },
        {
          "name": "ka2a-proxy",
          "image": "__IMAGE_URI__",
          "cpu": 0,
          "portMappings": [
            {
              "containerPort": 7007,
              "hostPort": 7007,
              "protocol": "tcp"
            }
          ],
          "essential": true,
          "command": [
            "proxy",
            "--agent-name",
            "host",
            "--host",
            "0.0.0.0",
            "--port",
            "7007"
          ],
          "environment": [
            {
              "name": "KA2A_CONTROL_PLANE_BASE_URL",
              "value": "http://127.0.0.1:7006"
            }
          ],
          "mountPoints": [],
          "volumesFrom": [],
          "systemControls": []
        },
        {
          "name": "voice-agent",
          "image": "__IMAGE_URI__",
          "cpu": 0,
          "portMappings": [],
          "essential": true,
          "command": [
            "voice"
          ],
          "environment": [
            {
              "name": "KA2A_CONTROL_PLANE_BASE_URL",
              "value": "http://127.0.0.1:7006"
            }
          ],
          "mountPoints": [],
          "volumesFrom": [],
          "systemControls": []
        }
      ],
      "requiresCompatibilities": [
        "FARGATE"
      ],
      "cpu": "1024",
      "memory": "4096",
      "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
      }
    }
  }
}
